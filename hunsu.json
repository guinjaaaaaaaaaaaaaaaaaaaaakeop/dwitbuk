{
  "engines": {
    "python": ">=3.11",
    "claude-code": ">=2.1"
  },
  "plugins": {
    "hunsu": {
      "version": "1.15.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hunsu",
      "marketplace": "hunsu"
    },
    "chongdae": {
      "version": "1.24.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/chongdae",
      "marketplace": "chongdae"
    },
    "mangsang": {
      "version": "1.19.3",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/mangsang",
      "marketplace": "mangsang"
    },
    "jokbo": {
      "version": "1.8.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/jokbo",
      "marketplace": "jokbo"
    },
    "hacheong": {
      "version": "1.12.1",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/hacheong",
      "marketplace": "hacheong"
    },
    "dwitbuk": {
      "version": "1.16.0",
      "source": "github:guinjaaaaaaaaaaaaaaaaaaaaakeop/dwitbuk",
      "marketplace": "dwitbuk"
    }
  },
  "roles": {
    "planner": "session",
    "implementer": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "dakdol",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex"
    ],
    "nitpick": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "teujip",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "claude"
    ],
    "quibble": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "sibi",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "claude"
    ],
    "newbie": [
      "python3",
      "{plugin:hacheong}/worker.py",
      "--member",
      "chojja",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "codex"
    ],
    "verifier": [
      "python3",
      "{plugin:dwitbuk}/eyes_worker.py",
      "--request",
      "{request}",
      "--response",
      "{response}",
      "--host",
      "claude"
    ],
    "reviewer": [
      "python3",
      "{plugin:dwitbuk}/dwitbuk.py",
      "review",
      "--target",
      "."
    ],
    "coherence": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--target",
      "."
    ]
  },
  "reporters": {
    "hunsu": [
      "python3",
      "{plugin:hunsu}/hunsu.py",
      "check",
      "--findings",
      "--target",
      "."
    ],
    "chongdae": [
      "python3",
      "{plugin:chongdae}/chongdae.py",
      "report",
      "--since",
      "{since}",
      "--target",
      "."
    ],
    "mangsang-impact": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "impact",
      "--findings",
      "--target",
      "."
    ],
    "mangsang-cq": [
      "python3",
      "{plugin:mangsang}/mangsang.py",
      "cq",
      "--findings",
      "--target",
      "."
    ]
  },
  "resolutions": {
    "carrying out a stated goal or plan": {
      "accept": "A build or test task that chongdae records as `--role session` (with its `--why`: the person's word for a small change, or taken by chongdae under hunsu.json `capabilities`) is the session's task, no longer a member's; hacheong's 'never do a member's work yourself' governs every task still assigned to a member. Never take a member's task without that recorded reason.",
      "reviewed": false
    },
    "reviewing, disputing or testing a change": {
      "accept": "This project's lock declares dwitbuk as chongdae's `reviewer`: the review runs when a run ends and `reviews/<id>.json` goes into that run's close commit (dwitbuk:review step 0). Do not run or commit a review by hand outside a run; a review a person asks for by hand is made and committed inside a run.",
      "reviewed": false
    },
    "asking what happened or what is open": {
      "accept": "Split by question: 'what is open' (undisposed objections, left-open tasks) goes to dwitbuk:review, read with `follow` on the latest review; 'what happened / what changed' goes to jokbo:read (`since`, `find`). When a person asks both, jokbo:read first for the account, then dwitbuk:review for what is still open. Neither runs a new review or disposes of findings unless the person asks.",
      "reviewed": false
    }
  },
  "local-hooks-ok": [],
  "capabilities": {
    "loopback": "session",
    "network": "session"
  }
}
