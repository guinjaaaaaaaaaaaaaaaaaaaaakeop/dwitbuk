{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 10,
            "statusMessage": "dwitbuk — anything left undisposed?"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_eyes.py\"",
            "timeout": 300,
            "statusMessage": "dwitbuk — eyes on what this session changed"
          }
        ]
      }
    ]
  }
}
